<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'TISSOT Watches' %> | TISSOT</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --gold: #b8960c;
      --gold-light: #d4af37;
      --dark: #111111;
      --dark-2: #1a1a1a;
      --text-muted: #888;
    }
    body { font-family: 'Inter', sans-serif; background: #fff; color: var(--dark); }

    /* ── Navbar ── */
    .navbar {
      background: var(--dark);
      border-bottom: 1px solid #2a2a2a;
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 70px;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }
    .brand-mark {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--gold-light);
      border: 1.5px solid var(--gold-light);
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 2px;
    }
    .brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 4px;
      display: block;
    }
    .brand-subtitle {
      font-size: 0.55rem;
      color: var(--gold-light);
      letter-spacing: 3px;
      font-weight: 400;
      display: block;
      margin-top: -2px;
    }
    .main-nav {
      display: flex;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: 0;
    }
    .main-nav li a {
      display: block;
      padding: 0 1.1rem;
      height: 70px;
      line-height: 70px;
      color: #ccc;
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      transition: color 0.2s, background 0.2s;
    }
    .main-nav li a:hover {
      color: var(--gold-light);
      background: rgba(255,255,255,0.04);
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .nav-user-name {
      font-size: 0.82rem;
      color: #aaa;
    }
    .nav-user-name strong { color: var(--gold-light); }
    .btn-nav {
      padding: 0.4rem 1rem;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      border-radius: 2px;
      text-decoration: none;
      cursor: pointer;
      border: none;
      display: inline-block;
    }
    .btn-nav-outline {
      border: 1px solid #555;
      color: #ccc;
      background: transparent;
    }
    .btn-nav-outline:hover { border-color: var(--gold-light); color: var(--gold-light); }
    .btn-nav-gold {
      background: var(--gold-light);
      color: var(--dark);
    }
    .btn-nav-gold:hover { background: #c9a227; }
    .cart-badge {
      background: var(--gold-light);
      color: var(--dark);
      border-radius: 50%;
      padding: 1px 6px;
      font-size: 0.72rem;
      font-weight: 700;
      margin-left: 3px;
    }

    /* ── Flash messages ── */
    .flash-bar { padding: 0.85rem 2rem; margin: 0; font-size: 0.88rem; }
    .flash-success { background: #14532d; color: #bbf7d0; border-bottom: 1px solid #166534; }
    .flash-error   { background: #7f1d1d; color: #fecaca; border-bottom: 1px solid #991b1b; }

    /* ── Page header strip ── */
    .page-header {
      background: var(--dark);
      color: #fff;
      padding: 2.5rem 2rem;
      margin-bottom: 2.5rem;
      text-align: center;
    }
    .page-header h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold-light);
      margin: 0;
    }
    .page-header p {
      color: #888;
      margin: 0.4rem 0 0;
      font-size: 0.85rem;
      letter-spacing: 1px;
    }

    /* ── Filter bar ── */
    .filter-bar {
      background: #f9f9f9;
      border: 1px solid #e5e5e5;
      border-radius: 4px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
    }
    .filter-bar label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #666;
      margin-bottom: 0.35rem;
    }
    .filter-bar input, .filter-bar select {
      width: 100%;
      padding: 0.6rem 0.8rem;
      border: 1px solid #ddd;
      border-radius: 3px;
      font-size: 0.88rem;
      color: var(--dark);
      background: #fff;
      font-family: 'Inter', sans-serif;
    }
    .filter-bar input:focus, .filter-bar select:focus {
      outline: none;
      border-color: var(--gold);
    }
    .btn-filter {
      background: var(--dark);
      color: var(--gold-light);
      border: 1px solid var(--dark);
      padding: 0.6rem 1.2rem;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      border-radius: 3px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
    }
    .btn-filter:hover { background: #222; }
    .btn-clear {
      background: transparent;
      color: #888;
      border: 1px solid #ddd;
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
      border-radius: 3px;
      text-decoration: none;
      display: inline-block;
    }
    .btn-clear:hover { border-color: #aaa; color: #555; }

    /* ── Product grid ── */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 2rem;
    }
    .product-card {
      border: 1px solid #e8e8e8;
      border-radius: 4px;
      overflow: hidden;
      transition: box-shadow 0.25s, transform 0.25s;
      background: #fff;
    }
    .product-card:hover {
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
      transform: translateY(-3px);
    }
    .product-card a img.product-image {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .product-card:hover img.product-image { transform: scale(1.04); }
    .product-info { padding: 1.2rem; }
    .product-category {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gold);
    }
    .product-title {
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      font-weight: 600;
      margin: 0.3rem 0 0.4rem;
      line-height: 1.3;
    }
    .product-desc {
      font-size: 0.8rem;
      color: #777;
      line-height: 1.5;
      margin-bottom: 0.6rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .rating-stars { color: var(--gold); font-size: 0.82rem; }
    .rating-count { color: #999; font-size: 0.78rem; }
    .stock-status { font-size: 0.76rem; margin: 0.3rem 0 0.6rem; }
    .stock-ok   { color: #15803d; }
    .stock-low  { color: #b45309; }
    .stock-none { color: #dc2626; }
    .product-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.8rem;
      border-top: 1px solid #f0f0f0;
      padding-top: 0.8rem;
    }
    .product-price {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--dark);
    }
    .btn-cart {
      background: var(--dark);
      color: var(--gold-light);
      border: none;
      padding: 0.45rem 0.9rem;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      border-radius: 2px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: background 0.2s;
    }
    .btn-cart:hover { background: #2a2a2a; }
    .btn-cart-disabled {
      background: #e5e5e5;
      color: #aaa;
      padding: 0.45rem 0.9rem;
      font-size: 0.75rem;
      border-radius: 2px;
      cursor: not-allowed;
    }

    /* ── Pagination ── */
    .pagination { display: flex; justify-content: center; gap: 0.4rem; margin-top: 3rem; flex-wrap: wrap; }
    .page-btn {
      display: inline-block;
      padding: 0.5rem 0.9rem;
      font-size: 0.82rem;
      font-weight: 600;
      border: 1px solid #ddd;
      border-radius: 2px;
      text-decoration: none;
      color: var(--dark);
      transition: all 0.2s;
    }
    .page-btn:hover, .page-btn.active {
      background: var(--dark);
      color: var(--gold-light);
      border-color: var(--dark);
    }

    /* ── Footer ── */
    .footer { background: var(--dark); color: #888; margin-top: 4rem; padding: 3rem 2rem 1.5rem; }
    .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 2rem; max-width: 1100px; margin: 0 auto; }
    .footer-col h4 { color: var(--gold-light); font-size: 0.72rem; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; margin: 0 0 1rem; }
    .footer-col ul { list-style: none; margin: 0; padding: 0; }
    .footer-col ul li { margin-bottom: 0.5rem; }
    .footer-col ul li a { color: #777; text-decoration: none; font-size: 0.83rem; transition: color 0.2s; }
    .footer-col ul li a:hover { color: var(--gold-light); }
    .footer-bottom { text-align: center; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid #222; font-size: 0.78rem; color: #444; }

    /* ── Buttons (general) ── */
    .btn { display: inline-block; padding: 0.65rem 1.4rem; border-radius: 3px; text-decoration: none; font-size: 0.83rem; font-weight: 600; letter-spacing: 0.5px; cursor: pointer; border: none; transition: all 0.2s; }
    .btn-primary { background: var(--dark); color: var(--gold-light); }
    .btn-primary:hover { background: #222; }
    .btn-secondary { background: transparent; color: var(--dark); border: 1px solid #ccc; }
    .btn-secondary:hover { border-color: var(--dark); }

    /* ── Containers ── */
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .shop-container { padding: 1rem 1.5rem 3rem; max-width: 1200px; margin: 0 auto; }
    .main-content { min-height: 60vh; }

    /* ── Forms (auth) ── */
    .auth-container { max-width: 440px; margin: 3rem auto; padding: 0 1rem; }
    .auth-card { background: #fff; border: 1px solid #e5e5e5; border-radius: 4px; padding: 2.5rem; box-shadow: 0 2px 16px rgba(0,0,0,0.06); }
    .auth-card h2 { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: var(--dark); margin-bottom: 0.3rem; }
    .auth-card p { color: #888; font-size: 0.85rem; margin-bottom: 1.8rem; }
    .form-group { margin-bottom: 1.2rem; }
    .form-group label { display: block; font-size: 0.78rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #555; margin-bottom: 0.4rem; }
    .form-group input { width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 3px; font-size: 0.9rem; font-family: 'Inter', sans-serif; box-sizing: border-box; }
    .form-group input:focus { outline: none; border-color: var(--gold); }
    .btn-auth { width: 100%; padding: 0.8rem; background: var(--dark); color: var(--gold-light); border: none; font-size: 0.85rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; border-radius: 3px; cursor: pointer; margin-top: 0.5rem; }
    .btn-auth:hover { background: #222; }
    .auth-link { text-align: center; margin-top: 1.2rem; font-size: 0.83rem; color: #888; }
    .auth-link a { color: var(--gold); text-decoration: none; font-weight: 600; }

    /* Admin table */
    .admin-table { width: 100%; border-collapse: collapse; }
    .admin-table th, .admin-table td { padding: 0.8rem 1rem; text-align: left; border-bottom: 1px solid #f0f0f0; font-size: 0.87rem; }
    .admin-table th { background: #f9f9f9; font-weight: 700; font-size: 0.72rem; letter-spacing: 1.5px; text-transform: uppercase; color: #555; }
    .admin-table tr:hover td { background: #fdfdfd; }
    .admin-card { background: #fff; border: 1px solid #e8e8e8; border-radius: 4px; padding: 2rem; margin-bottom: 1.5rem; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 2px; font-size: 0.75rem; font-weight: 600; }
    .btn-sm { padding: 0.3rem 0.75rem; font-size: 0.78rem; }
  </style>
</head>
<body>

  <%# ── Navbar ──────────────────────────────────────────────────────────── %>
  <nav class="navbar">
    <div class="header-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark">T</span>
        <span class="brand-text">
          <span class="brand-name">TISSOT</span>
          <span class="brand-subtitle">SWISS WATCHES SINCE 1853</span>
        </span>
      </a>

      <ul class="main-nav">
        <li><a href="/shop">Collection</a></li>
        <li><a href="/onsale-products">On Sale</a></li>
        <% if (categories && categories.length > 0) { %>
          <% categories.slice(0, 5).forEach(cat => { %>
            <li><a href="/shop?category=<%= cat.slug %>"><%= cat.name %></a></li>
          <% }) %>
        <% } %>
      </ul>

      <div class="header-actions">
        <%# Lab 3: Dynamic navbar — guest vs logged-in %>
        <% if (user) { %>
          <span class="nav-user-name">Hello, <strong><%= user.name %></strong></span>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="btn-nav btn-nav-outline">Admin</a>
          <% } %>
          <a href="/cart" class="btn-nav btn-nav-outline">
            Cart<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
          </a>
          <a href="/auth/logout" class="btn-nav btn-nav-gold">Logout</a>
        <% } else { %>
          <a href="/cart" class="btn-nav btn-nav-outline">
            Cart<% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
          </a>
          <a href="/auth/login"    class="btn-nav btn-nav-outline">Login</a>
          <a href="/auth/register" class="btn-nav btn-nav-gold">Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <%# ── Flash Messages ───────────────────────────────────────────────────── %>
  <% if (success_msg && success_msg.length > 0) { %>
    <% success_msg.forEach(msg => { %>
      <div class="flash-bar flash-success">✓ &nbsp;<%= msg %></div>
    <% }) %>
  <% } %>
  <% if (error_msg && error_msg.length > 0) { %>
    <% error_msg.forEach(msg => { %>
      <div class="flash-bar flash-error">⚠ &nbsp;<%= msg %></div>
    <% }) %>
  <% } %>

  <main class="main-content">
    <%- body %>
  </main>

  <%# ── Footer ────────────────────────────────────────────────────────────── %>
  <footer class="footer">
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Collection</h4>
        <ul>
          <li><a href="/shop">All Watches</a></li>
          <% if (categories) { categories.forEach(cat => { %>
            <li><a href="/shop?category=<%= cat.slug %>"><%= cat.name %></a></li>
          <% }) } %>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Account</h4>
        <ul>
          <% if (user) { %>
            <li><a href="/auth/logout">Logout</a></li>
            <% if (user.role === 'admin') { %><li><a href="/admin">Admin Panel</a></li><% } %>
          <% } else { %>
            <li><a href="/auth/login">Login</a></li>
            <li><a href="/auth/register">Create Account</a></li>
          <% } %>
          <li><a href="/cart">My Cart</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="#">Watch Servicing</a></li>
          <li><a href="#">Authenticity</a></li>
          <li><a href="#">Strap Guide</a></li>
          <li><a href="#">Gift Wrapping</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>TISSOT</h4>
        <ul>
          <li><a href="#">Our Story</a></li>
          <li><a href="#">Craftsmanship</a></li>
          <li><a href="#">Sustainability</a></li>
          <li><a href="#">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 TISSOT Swiss Watches. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
